# Where products come from: the bundled demo shop, or a live WooCommerce one.
STORE_SOURCE=demo

# Only needed when STORE_SOURCE=woocommerce. Generate the key pair under
# WooCommerce > Settings > Advanced > REST API, with read/write access.
WOO_BASE_URL=
WOO_KEY=
WOO_SECRET=

# Bind address for the Streamable HTTP endpoint
HOST=127.0.0.1
PORT=8080
